          </instance-parameter>
          <parameter name="limit" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="libgcab/gcab-cabinet.c"
                 line="472">maximum number of bytes to write while extracting, or 0 for no limit</doc>
            <type name="guint64" c:type="guint64"/>
          </parameter>
        </parameters>
