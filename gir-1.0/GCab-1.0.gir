        <doc xml:space="preserve"
             filename="libgcab/gcab-cabinet.c"
             line="469">Set an upper bound on the total number of uncompressed bytes written by
gcab_cabinet_extract().  The default is 4 GiB.  This limits decompression
bombs and runaway extraction into memory or disk.  Set @limit to 0 to
disable the absolute limit and rely only on the ratio limit.</doc>
        <source-position filename="libgcab/gcab-cabinet.h" line="109"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
